{
  "expo": {
    "name": "Broiler Farm Manager",
    "slug": "broiler-farm-manager",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "broilerfarm",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.broilerfarm.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.broilerfarm.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png",
      "themeColor": "#0F172A",
      "backgroundColor": "#0F172A",
      "display": "standalone",
      "orientation": "portrait",
      "name": "Broiler Farm Manager",
      "shortName": "Broiler Farm",
      "description": "Offline-First Broiler Farm Management System",
      "startUrl": "/"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
